      "dispatch": {
        "_concept": "dcp_dispatch_policy",
        "package_name": "ffmpeg-dcp-social-v2/ffmpeg-wasm.js",
        "target_chunk_frames": 90,
        "dedupe_identical_formats": true,
        "unit": "(chunk, unique format signature)",
