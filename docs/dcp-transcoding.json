      },
      "bank": {
        "_concept": "dcp_bank_query",
        "service": "bankTeller",
        "operation": "viewAccount",
        "address_field": "address",
        "authorize_with": "account_key",
        "balance_field": "payload.balance",
        "unit": "⊇",
        "notes": "Identity must be set before opening the teller connection (EHAVEIDENTITY is non-fatal). The queried account key may also be the identity. Request viewAccount with { address }, authorize with that account's PrivateKey or Keystore, then read payload.balance.\n"
      },
      "github": {
        "_concept": "github_transcode_policy",
        "owner": "exergy-connect",
        "repo": "ffmpeg-dcp",
        "branch": "main",
        "upload_prefix": "docs/uploads",
        "workflow_file": "self-hosted-runner-test.yml",
        "runner_bundle_url": "https://raw.githubusercontent.com/exergy-connect/ffmpeg-dcp/main/xframe/github/dist/github-runner.min.js",
        "dcp_package": "dcp-gh-runner/dcpGhRunner.js",
        "token_storage_key": "xframe-social:githubToken",
        "max_upload_bytes": 95000000,
        "notes": "Browser uploads via GitHub Contents API, dispatches the self-hosted runner test workflow, then pays for one DCP slice whose work function lists dcp-gh-runner/dcpGhRunner.js and ffmpeg-dcp-social-v2/ffmpeg-wasm.js in job.requires (packages ship with the job). The slice JIT-registers as a GitHub Actions runner, transcodes to li_feed MP4, then publishes via LinkedIn REST (when token + URN provided) or GitHub commit + post-to-linkedin workflow.\n"
      },
      "pipeline": {
        "probe": {
          "_concept": "pipeline_stage",
          "id": "probe",
          "label": "Probe WebM",
          "parallel": false,
          "description": "Confirm VP8/VP9, dimensions, audio presence, and timing."
        },
        "slice": {
          "_concept": "pipeline_stage",
          "id": "slice",
          "label": "Keyframe-aligned WebM slice",
          "parallel": false,
          "description": "Stream-copy independent WebM chunks at video keyframes (~3 s @ 30 fps)."
        },
        "encode": {
          "_concept": "pipeline_stage",
          "id": "encode",
          "label": "DCP encode",
          "parallel": true,
          "description": "One fleet slice per (chunk, unique format). Decode once per worker unit; emit H.264/AAC MPEG-TS."
        },
        "assemble": {
          "_concept": "pipeline_stage",
          "id": "assemble",
          "label": "Assemble + remux MP4",
          "parallel": true,
          "description": "Ordered concat per format signature, then faststart MP4 remux. Independent signatures finalize concurrently."
        }
      },
