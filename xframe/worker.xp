---
# xFrame browser worker — semantic document
# Simplified dcp.live-style participant page with an optional worker comment
# injected into sandboxes as dcpWorkerContext for job result labeling.

_id: worker

_document:
  _output:
    _location: output
    _basename: worker
    _extension: html

_final:
  _templates: file://./templates/worker/_final/

# ---------------------------------------------------------------------------
# Shapes
# ---------------------------------------------------------------------------

compute_group:
  _attributes:
    joinKey: { _type: _string, _required: true }
    joinSecret: { _type: _string, _required: true }

url_option:
  _attributes:
    name: { _type: _string, _required: true }
    description: _string
    default: _string

worker_comment_policy:
  _attributes:
    storage_key: _string
    max_length: _integer
    exposure: _string
    placeholder: _string
    notes: _string

worker_identity_policy:
  _attributes:
    storage_key: _string
    max_length: _integer
    default: _string
    placeholder: _string
    notes: _string

worker_language_policy:
  _attributes:
    storage_key: _string
    default: _string
    notes: _string

browser_worker_defaults:
  _attributes:
    payment_address: _string
    max_sandboxes: _integer
    leave_public_group: _boolean
    compute_groups: [compute_group]
    notes: _string

browser_worker_app:
  _attributes:
    title: _string
    tagline: _string
    runtime_script: _string
    dcp_client_url: _string
    cloud_signup_url: _string
    defaults: { _concept: browser_worker_defaults }
    identity: { _concept: worker_identity_policy }
    comment: { _concept: worker_comment_policy }
    language: { _concept: worker_language_policy }
    url_options: { _dict: url_option }

# ---------------------------------------------------------------------------
# App instance
# ---------------------------------------------------------------------------

app:
  _concept: browser_worker_app
  title: DCP Browser Worker
  tagline: Donate idle cycles
  runtime_script: worker.js
  dcp_client_url: https://scheduler.distributed.computer/dcp-client/dcp-client.js
  cloud_signup_url: https://dcp.cloud

  defaults:
    _concept: browser_worker_defaults
    payment_address: "0xf221901f78c5407ca5c2837bdc4fc49ede0b8fe8"
    max_sandboxes: 2
    leave_public_group: true
    compute_groups:
      - joinKey: demo
        joinSecret: dcp
      - joinKey: exergy
        joinSecret: xp      
    notes: Defaults mirror the public dcp.live demo posture.

  identity:
    _concept: worker_identity_policy
    storage_key: xframe.worker.identity
    max_length: 40
    default: "(anonymous)"
    placeholder: "(anonymous)"
    notes: >-
      Display name used in supervisor logs and prefixed onto the platform
      comment as "<identity>: <comment>".

  comment:
    _concept: worker_comment_policy
    storage_key: xframe.worker.comment
    max_length: 280
    exposure: sandbox_context_and_results
    placeholder: "Share a thought"
    notes: >-
      Optional comment under Show up. Field value defaults empty;
      placeholder is quiet invitation copy.
      Set via the Comment field, ?comment= / ?workerComment=, or localStorage.
      Sent to the platform as { text: "<identity>: <comment>", language } in
      dcpWorkerContext.

  language:
    _concept: worker_language_policy
    storage_key: xframe.worker.language
    default: "en-US"
    notes: >-
      BCP 47 tag from the Comment language selector (browser speech voices).
      Passed with each worker comment for transcoder text-to-speech.

  url_options:
    paymentAddress:
      _concept: url_option
      name: paymentAddress
      description: Bank address that receives earned compute credits
      default: "{{ app.defaults.payment_address }}"
    jobIds:
      _concept: url_option
      name: jobIds
      description: Comma-separated job IDs to restrict this worker
      default: ""
    computeGroups:
      _concept: url_option
      name: computeGroups
      description: joinKey,joinSecret pair or JSON array of groups
      default: "demo,dcp"
    leavePublicGroup:
      _concept: url_option
      name: leavePublicGroup
      description: true leaves the public group; false stays in public
      default: "true"
    maxSandboxes:
      _concept: url_option
      name: maxSandboxes
      description: Maximum concurrent sandboxes
      default: "2"
    comment:
      _concept: url_option
      name: comment
      description: Optional worker comment text (combined with identity for platform results; alias workerComment)
      default: ""
    identity:
      _concept: url_option
      name: identity
      description: Worker display name used in logs and as the platform comment prefix
      default: "(anonymous)"
    language:
      _concept: url_option
      name: language
      description: BCP 47 language tag for comment text-to-speech on the transcoder
      default: "en-US"

_assert:
  - test: "{{ app.runtime_script == 'worker.js' }}"
    message: Worker app must load worker.js
  - test: "{{ app.identity.default == '(anonymous)' }}"
    message: Worker identity must default to (anonymous)
  - test: "{{ app.comment.exposure == 'sandbox_context_and_results' }}"
    message: Worker comment must be injected into sandbox context for result labeling
  - test: "{{ app.comment.max_length >= 280 }}"
    message: Comment max length must be at least 280
  - test: "{{ app.defaults.max_sandboxes >= 1 }}"
    message: Default maxSandboxes must be at least 1
  - test: "{{ app.language.default == 'en-US' }}"
    message: Worker comment language must default to en-US
---
_id: app
===
{# Body is replaced by templates/worker/_final/html.xpt when --final html is used. #}
DCP Browser Worker concepts loaded.
