---
# DCP Social Media Transcoder — semantic document
# Compiles to a functional HTML app that accepts MediaRecorder WebM
# (VP8/VP9 + Opus) and dispatches H.264/AAC MP4 masters via DCP.

{% include "file://./demo/demoMessages.xp" as demo %}

_id: dcp-transcoding

_document:
  _output:
    _location: output
    _basename: dcp-transcoding
    _extension: html

_final:
  _templates: file://./templates/_final/

# ---------------------------------------------------------------------------
# Shapes
# ---------------------------------------------------------------------------

video_codec:
  _attributes:
    name: _string
    fourcc: _string
    notes: _string

audio_codec:
  _attributes:
    name: _string
    sample_rate_hz: _integer
    channels: _integer
    notes: _string

container_format:
  _attributes:
    name: _string
    mime: _string
    extension: _string

framing_mode:
  _attributes:
    id: _string
    label: _string
    description: _string

color_policy:
  _attributes:
    primaries: _string
    transfer: _string
    matrix: _string
    range: _string
    pixel_format: _string

timing_policy:
  _attributes:
    output_fps: _integer
    mode: _string
    gop_seconds: _integer
    notes: _string

video_format_specification:
  _attributes:
    id: { _type: _string, _required: true }
    width: { _type: _integer, _required: true }
    height: { _type: _integer, _required: true }
    aspect: { _type: _string, _required: true }
    video_bitrate_kbps: { _type: _integer, _required: true }
    audio_bitrate_kbps: { _type: _integer, _required: true }
    max_fps: { _type: _integer, _required: true }
    video_codec: _string
    audio_codec: _string
    container: _string
    profile: _string
    pixel_format: _string
    gop_seconds: _integer
    signature: _string
    notes: _string

placement_profile:
  _attributes:
    id: { _type: _string, _required: true }
    label: { _type: _string, _required: true }
    family: { _type: _string, _required: true }
    format: { _concept: video_format_specification }
    default_selected: _boolean

# Organic post body constraints (LinkedIn enforces 1200 characters).
social_post:
  _attributes:
    max_characters: { _type: _integer, _required: true }
    notes: _string

social_media_platform:
  _attributes:
    id: { _type: _string, _required: true }
    name: { _type: _string, _required: true }
    placements: { _dict: placement_profile }
    post: { _concept: social_post }
    notes: _string

pipeline_stage:
  _attributes:
    id: _string
    label: _string
    parallel: _boolean
    description: _string

browser_recording_input:
  _attributes:
    container: _string
    video_codecs: [_string]
    audio_codecs: [_string]
    timing: _string
    color: _string
    mime_preference: [_string]

dcp_dispatch_policy:
  _attributes:
    package_name: _string
    target_chunk_frames: _integer
    dedupe_identical_formats: _boolean
    unit: _string
    notes: _string

# Bank teller protocol proven by test/accountBalance.js (viewAccount, not viewAccounts).
dcp_bank_query:
  _attributes:
    service: _string
    operation: _string
    address_field: _string
    authorize_with: _string
    balance_field: _string
    unit: _string
    notes: _string

github_transcode_policy:
  _attributes:
    owner: _string
    repo: _string
    branch: _string
    upload_prefix: _string
    workflow_file: _string
    runner_bundle_url: _string
    dcp_package: _string
    token_storage_key: _string
    max_upload_bytes: _integer
    notes: _string

# Public browser-worker landing page encoded by the account QR code.
browser_worker_invite:
  _attributes:
    url: { _type: _string, _required: true }
    notes: _string

demo_message_quote:
  _attributes:
    language: { _type: _string, _required: true }
    text: { _type: _string, _required: true }

demo_message:
  _attributes:
    id: { _type: _string, _required: true }
    title: _string
    quotes: [demo_message_quote]

audience_emulation:
  _attributes:
    enabled_default: _boolean
    chance_percent: _integer
    audio_base: _string
    messages: [demo_message]
    notes: _string

dcp_transcoding_app:
  _attributes:
    title: _string
    tagline: _string
    default_framing: _string
    runtime_script: _string
    bank_script: _string
    worker_script: _string
    deploy_worker_script: _string
    wasm_glue: _string
    wasm_binary: _string
    dcp_package: _string
    worker_invite: { _concept: browser_worker_invite }
    audience: { _concept: audience_emulation }
    containers: { _dict: container_format }
    framing: { _dict: framing_mode }
    color: { _dict: color_policy }
    timing: { _dict: timing_policy }
    input: { _concept: browser_recording_input }
    dispatch: { _concept: dcp_dispatch_policy }
    bank: { _concept: dcp_bank_query }
    github: { _concept: github_transcode_policy }
    pipeline: { _dict: pipeline_stage }
    formats: { _dict: video_format_specification }
    platforms: { _dict: social_media_platform }


# ---------------------------------------------------------------------------
# App instance (the only top-level data concept passed to the browser)
# ---------------------------------------------------------------------------

app:
  _concept: dcp_transcoding_app
  title: DCP Social Media Transcoder
  tagline: Record in the browser. Select platforms. Transcode on DCP. Influence the world.
  default_framing: cover
  runtime_script: dcp-transcoding.js
  bank_script: dcp-bank-account.js
  worker_script: ffmpeg-worker.js
  deploy_worker_script: dcp-deploy-worker.js
  wasm_glue: ffmpeg-wasm/dcp-transcode-glue.js
  wasm_binary: ffmpeg-wasm/dcp-transcode.wasm
  dcp_package: ffmpeg-dcp-social-v2/ffmpeg-wasm.js
  worker_invite:
    _concept: browser_worker_invite
    url: https://exergy-connect.github.io/ffmpeg-dcp/worker.html
    notes: Public GitHub Pages browser worker encoded by the account QR code (replaces dcp.live).

  audience:
    _concept: audience_emulation
    enabled_default: true
    chance_percent: 25
    audio_base: demoMessages/audio/gemini
    messages: "{{ demo.messages }}"
    notes: >-
      When Emulate audience is on, each DCP slice that arrives with no worker
      comment is considered for a unique catalog quote (Gemini WAV). The insert
      chance starts at chance_percent and rises as remaining empty slices shrink
      (remaining messages / remaining empty slices), reaching 100% once no spare
      slices remain, so the full catalog is placed by the end of the job with
      high probability. Messages are never reused in the same job. Playback of
      an earlier comment only skips a roll while spare slices remain.

  codecs:
    vp8:
      _concept: video_codec
      name: VP8
      fourcc: vp8
      notes: Common MediaRecorder fallback
    vp9:
      _concept: video_codec
      name: VP9
      fourcc: vp9
      notes: Preferred MediaRecorder video codec when supported
    h264:
      _concept: video_codec
      name: H.264 / AVC
      fourcc: avc1
      notes: Cross-platform social upload master video codec
    opus:
      _concept: audio_codec
      name: Opus
      sample_rate_hz: 48000
      channels: 2
      notes: Typical MediaRecorder audio codec
    aac_lc:
      _concept: audio_codec
      name: AAC-LC
      sample_rate_hz: 48000
      channels: 2
      notes: Cross-platform social upload master audio codec

  containers:
    webm:
      _concept: container_format
      name: WebM
      mime: video/webm
      extension: webm
    mp4:
      _concept: container_format
      name: MP4
      mime: video/mp4
      extension: mp4
    mpegts:
      _concept: container_format
      name: MPEG-TS
      mime: video/mp2t
      extension: ts

  framing:
    cover:
      _concept: framing_mode
      id: cover
      label: Fill (center crop)
      description: Scale to cover the target canvas, then center-crop. Prefer for feed and short-form masters.
    contain:
      _concept: framing_mode
      id: contain
      label: Fit (pad)
      description: Scale to fit inside the target canvas and pad. Prefer when the full frame must be preserved.
    stretch:
      _concept: framing_mode
      id: stretch
      label: Stretch
      description: Distorts to exact width×height. Avoid for social masters.

  color:
    sdr_bt709:
      _concept: color_policy
      primaries: bt709
      transfer: bt709
      matrix: bt709
      range: limited
      pixel_format: yuv420p

  timing:
    social_default:
      _concept: timing_policy
      output_fps: 30
      mode: cfr
      gop_seconds: 2
      notes: Normalize browser VFR MediaRecorder timelines to 30 fps CFR.

  input:
    _concept: browser_recording_input
    container: webm
    video_codecs: [vp9, vp8]
    audio_codecs: [opus]
    timing: Potentially VFR; normalize to 30 fps CFR
    color: Assume SDR unless proven otherwise
    mime_preference:
      - "video/webm;codecs=vp9,opus"
      - "video/webm;codecs=vp8,opus"

  dispatch:
    _concept: dcp_dispatch_policy
    package_name: ffmpeg-dcp-social-v2/ffmpeg-wasm.js
    target_chunk_frames: 90
    dedupe_identical_formats: true
    unit: "(chunk, unique format signature)"
    notes: Identical Meta feed/reels specs encode once and alias to every selected deliverable name.

  bank:
    _concept: dcp_bank_query
    service: bankTeller
    operation: viewAccount
    address_field: address
    authorize_with: account_key
    balance_field: payload.balance
    unit: "⊇"
    notes: >
      Identity must be set before opening the teller connection (EHAVEIDENTITY is
      non-fatal). The queried account key may also be the identity. Request
      viewAccount with { address }, authorize with that account's PrivateKey or
      Keystore, then read payload.balance.

  github:
    _concept: github_transcode_policy
    owner: exergy-connect
    repo: ffmpeg-dcp
    branch: main
    upload_prefix: docs/uploads
    workflow_file: self-hosted-runner-test.yml
    runner_bundle_url: https://raw.githubusercontent.com/exergy-connect/ffmpeg-dcp/main/xframe/github/dist/github-runner.min.js
    dcp_package: dcp-gh-runner/dcpGhRunner.js
    token_storage_key: xframe-social:githubToken
    max_upload_bytes: 95000000
    notes: >
      Browser uploads via GitHub Contents API, dispatches the self-hosted runner
      test workflow, then pays for one DCP slice whose work function lists
      dcp-gh-runner/dcpGhRunner.js and ffmpeg-dcp-social-v2/ffmpeg-wasm.js in
      job.requires (packages ship with the job). The slice JIT-registers as a
      GitHub Actions runner, transcodes to li_feed MP4, then publishes via
      LinkedIn REST (when token + URN provided) or GitHub commit +
      post-to-linkedin workflow.

  pipeline:
    probe:
      _concept: pipeline_stage
      id: probe
      label: Probe WebM
      parallel: false
      description: Confirm VP8/VP9, dimensions, audio presence, and timing.
    slice:
      _concept: pipeline_stage
      id: slice
      label: Keyframe-aligned WebM slice
      parallel: false
      description: Stream-copy independent WebM chunks at video keyframes (~3 s @ 30 fps).
    encode:
      _concept: pipeline_stage
      id: encode
      label: DCP encode
      parallel: true
      description: One fleet slice per (chunk, unique format). Decode once per worker unit; emit H.264/AAC MPEG-TS.
    assemble:
      _concept: pipeline_stage
      id: assemble
      label: Assemble + remux MP4
      parallel: true
      description: >-
        Remux a format as soon as every segment for that signature has been
        received. Do not wait for remaining fleet slices to finish processing.
        Independent signatures finalize concurrently.

  # ---------------------------------------------------------------------------
  # Format specifications (upload masters from the social guide)
  # ---------------------------------------------------------------------------

  formats:
    yt_feed:
      _concept: video_format_specification
      id: yt-feed
      width: 1920
      height: 1080
      aspect: "16:9"
      video_bitrate_kbps: 8000
      audio_bitrate_kbps: 192
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "1920x1080-8000-192-30"
      notes: YouTube long-form 1080p SDR upload master
    yt_shorts:
      _concept: video_format_specification
      id: yt-shorts
      width: 1080
      height: 1920
      aspect: "9:16"
      video_bitrate_kbps: 8000
      audio_bitrate_kbps: 192
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "1080x1920-8000-192-30"
      notes: YouTube Shorts vertical master
    x_feed:
      _concept: video_format_specification
      id: x-feed
      width: 1280
      height: 720
      aspect: "16:9"
      video_bitrate_kbps: 6000
      audio_bitrate_kbps: 128
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "1280x720-6000-128-30"
      notes: X timeline 720p master for broadest playback
    x_vertical:
      _concept: video_format_specification
      id: x-vertical
      width: 720
      height: 1280
      aspect: "9:16"
      video_bitrate_kbps: 6000
      audio_bitrate_kbps: 128
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "720x1280-6000-128-30"
      notes: X vertical master
    meta_feed:
      _concept: video_format_specification
      id: meta-feed
      width: 1080
      height: 1350
      aspect: "4:5"
      video_bitrate_kbps: 7000
      audio_bitrate_kbps: 160
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "1080x1350-7000-160-30"
      notes: Shared Instagram/Facebook feed master
    meta_reels:
      _concept: video_format_specification
      id: meta-reels
      width: 1080
      height: 1920
      aspect: "9:16"
      video_bitrate_kbps: 9000
      audio_bitrate_kbps: 160
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "1080x1920-9000-160-30"
      notes: Shared Instagram/Facebook Reels master
    li_feed:
      _concept: video_format_specification
      id: li-feed
      width: 1080
      height: 1350
      aspect: "4:5"
      video_bitrate_kbps: 6000
      audio_bitrate_kbps: 160
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "1080x1350-6000-160-30"
      notes: LinkedIn ad-safe vertical feed master
    li_vertical:
      _concept: video_format_specification
      id: li-vertical
      width: 1080
      height: 1920
      aspect: "9:16"
      video_bitrate_kbps: 6000
      audio_bitrate_kbps: 160
      max_fps: 30
      video_codec: h264
      audio_codec: aac_lc
      container: mp4
      profile: main
      pixel_format: yuv420p
      gop_seconds: 2
      signature: "1080x1920-6000-160-30"
      notes: LinkedIn vertical / ads-max master

  # ---------------------------------------------------------------------------
  # Platforms (nested placements)
  # ---------------------------------------------------------------------------

  platforms:
    youtube:
      _concept: social_media_platform
      id: youtube
      name: YouTube
      notes: Bitrate-hungry; prefer native 16:9 and 9:16 without baked bars.
      placements:
        feed:
          _concept: placement_profile
          id: yt-feed
          label: Long-form / feed
          family: feed
          format: "{{ app.formats.yt_feed }}"
          default_selected: true
        shorts:
          _concept: placement_profile
          id: yt-shorts
          label: Shorts
          family: vertical
          format: "{{ app.formats.yt_shorts }}"
          default_selected: false
    x:
      _concept: social_media_platform
      id: x
      name: X (Twitter)
      notes: 720p default for broadest playback; Premium 1080p is optional elsewhere.
      placements:
        feed:
          _concept: placement_profile
          id: x-feed
          label: Timeline
          family: feed
          format: "{{ app.formats.x_feed }}"
          default_selected: true
        vertical:
          _concept: placement_profile
          id: x-vertical
          label: Vertical
          family: vertical
          format: "{{ app.formats.x_vertical }}"
          default_selected: false
    instagram:
      _concept: social_media_platform
      id: instagram
      name: Instagram
      notes: Shares Meta feed/reels geometry with Facebook for encode dedupe.
      placements:
        feed:
          _concept: placement_profile
          id: ig-feed
          label: Feed (4:5)
          family: feed
          format: "{{ app.formats.meta_feed }}"
          default_selected: true
        reels:
          _concept: placement_profile
          id: ig-reels
          label: Reels
          family: vertical
          format: "{{ app.formats.meta_reels }}"
          default_selected: false
    facebook:
      _concept: social_media_platform
      id: facebook
      name: Facebook
      notes: Same Meta masters as Instagram; identical signatures encode once.
      placements:
        feed:
          _concept: placement_profile
          id: fb-feed
          label: Feed (4:5)
          family: feed
          format: "{{ app.formats.meta_feed }}"
          default_selected: true
        reels:
          _concept: placement_profile
          id: fb-reels
          label: Reels
          family: vertical
          format: "{{ app.formats.meta_reels }}"
          default_selected: false
    linkedin:
      _concept: social_media_platform
      id: linkedin
      name: LinkedIn
      notes: Ad-safe ≤30 fps masters for organic and sponsored reuse.
      post:
        _concept: social_post
        max_characters: 1200
        notes: LinkedIn organic post body limit.
      placements:
        feed:
          _concept: placement_profile
          id: li-feed
          label: Feed (4:5)
          family: feed
          format: "{{ app.formats.li_feed }}"
          default_selected: true
        vertical:
          _concept: placement_profile
          id: li-vertical
          label: Vertical
          family: vertical
          format: "{{ app.formats.li_vertical }}"
          default_selected: false

---
_id: app
===
{# Body is replaced by templates/_final/html.xpt when --final html is used.
   This segment exists so the document always has a body for non-final compiles. #}
DCP Social Media Transcoder concepts loaded.
