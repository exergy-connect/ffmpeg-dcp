---
# Cover slide typography — centered quote on the canvas.
---
[data-layout="cover"] {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

[data-layout="cover"] [data-region="main"],
#xframe[data-xframe-positioning="dynamic"] [data-layout="cover"] [data-region="main"] {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 3.5rem 4.5rem;
  text-align: center;
}

[data-layout="cover"] h1 {
  margin: 0 0 1.25rem;
  font-size: 2.6rem;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: -0.02em;
}

[data-layout="cover"] p {
  margin: 0.35rem 0;
  font-size: 1.35rem;
  line-height: 1.45;
  color: var(--muted);
}
