+#ifdef __EMSCRIPTEN__
+bool FrameEncoder::start()
+{
+    /* Synchronous stand-in for Thread::start() + the first half of
+     * threadMain() - see the comment on this method's declaration in
+     * frameencoder.h for why this is safe in this sandbox. */
+    runThreadInit();
+    m_done.trigger(); /* signal that "thread" is initialized */
+    return true;
+}
+
+void FrameEncoder::stop()
+{
+    /* nothing to join - start() never spawned a real thread */
