# Build output - build.sh regenerates these from source. Committed
# anyway for ffmpeg-wasm/dcp-transcode(-glue).(js|wasm) specifically -
# see the exception below - so a plain `git clone` is runnable with no
# build step; anything else matching these patterns still isn't.
*.wasm
wasm-bytes.js
*-glue.js
*-glue.wasm
!/ffmpeg-wasm/dcp-transcode-glue.js
!/ffmpeg-wasm/dcp-transcode.wasm
!/xframe/ffmpeg-wasm/dcp-transcode-glue.js
!/xframe/ffmpeg-wasm/dcp-transcode.wasm
!/xframe/output/ffmpeg-wasm/dcp-transcode-glue.js
!/xframe/output/ffmpeg-wasm/dcp-transcode.wasm

# Test-run output - regenerated by running the test scripts, not fixtures.
hls-output/
thumbnails-output/
*-output.log

# Local scratch input for manual testing - not a fixture.
test-input/

# macOS Finder metadata
.DS_Store
