# Build output - build.sh regenerates these from source. Committed
# anyway for the canonical modules below so a plain `git clone` is
# runnable with no build step; anything else matching these patterns
# still isn't.
*.wasm
wasm-bytes.js
*-glue.js
*-glue.wasm
# Root ABR demo (ffmpeg-wasm-test)
!/ffmpeg-wasm/dcp-transcode-glue.js
!/ffmpeg-wasm/dcp-transcode.wasm
# xFrame social transcoder — single checked-in copy (do not also commit
# xframe/output/ffmpeg-wasm/; the staged worker loads ../ffmpeg-wasm/).
!/xframe/ffmpeg-wasm/dcp-transcode-glue.js
!/xframe/ffmpeg-wasm/dcp-transcode.wasm

# Staged deploy tree must not re-check-in the social WASM.
/xframe/output/ffmpeg-wasm/

# Test-run output - regenerated by running the test scripts, not fixtures.
hls-output/
thumbnails-output/
*-output.log

# Local scratch input for manual testing - not a fixture.
test-input/

# macOS Finder metadata
.DS_Store
